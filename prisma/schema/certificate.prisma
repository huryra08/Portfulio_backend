model Certificate {
  id            String    @id @default(uuid())
  title         String
  issuer        String    // who gave it, e.g. "Apollo Level 2", "Coursera"
  issueDate     DateTime
  expiryDate    DateTime? // null = does not expire
  credentialId  String?
  credentialUrl String?   // link to verify it
  imageUrl      String?   // picture of the certificate
  description   String?   @db.Text
  order         Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([order, issueDate])
  @@map("certificates")
}
