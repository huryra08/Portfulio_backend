model Skill {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(255)
  category  String
  level     Int?
  iconUrl   String?
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  ProjectSkill[]

  @@map("skills")
}
