model Experience {
  id          String    @id @default(uuid())
  company     String
  position    String
  description String?   @db.Text
  location    String?
  startDate   DateTime
  endDate     DateTime? // null = current
  order       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("experiences")
}
