              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ],
              "query": [
                {
                  "key": "featured",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "skill",
                  "value": "TypeScript",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/my-first-project",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "my-first-project"
              ]
            }
          }
        },
        {
          "name": "Get all incl. drafts (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/admin/all",
